# Shared platform data root (all persistent data lives under $TRADEQ_DATA_DIR/agent-arena/).
TRADEQ_DATA_DIR=/absolute/path/to/Tradeq/data

# Optional override of the settings file location.
ARENA_SETTINGS_FILE=config/settings.yaml

# I9 gateway secrets.
ARENA_GATEWAY__ADMIN_KEY=change-me
# Used only when the gateway does not return a per-session agent key.
ARENA_GATEWAY__AGENT_KEY=

# LLM provider keys (needed only for real LLM agents; the demo and tests use scripted doubles).
ARENA_PROVIDERS__OPENAI_COMPAT__API_KEY=
ARENA_PROVIDERS__ANTHROPIC__API_KEY=

# Examples of non-secret overrides.
# ARENA_GATEWAY__MCP_URL=http://127.0.0.1:8608/mcp
# ARENA_STATS__BOOTSTRAP_SAMPLES=5000
